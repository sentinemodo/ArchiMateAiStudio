# Copy to .env for local development (never commit .env).

# Optional PostgreSQL connection. When unset, the API uses in-memory stores (CI-friendly).
# Prefer keyword format, or a postgres:// URI (converted automatically).
DATABASE_URL=Host=127.0.0.1;Port=5432;Database=archimate_ai_studio;Username=postgres;Password=CHANGE_ME

# Alternative to DATABASE_URL (ASP.NET Core ConnectionStrings:Default):
# ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=archimate_ai_studio;Username=postgres;Password=CHANGE_ME

# RunPod — when RUNPOD_API_KEY is set, registers RunPodOpenAiChatClient; otherwise StubLlmChatClient.
# RUNPOD_API_KEY=
# Prefer an explicit OpenAI-compatible base URL:
# RUNPOD_OPENAI_BASE_URL=https://api.runpod.ai/v2/<endpointId>/openai/v1
# Or build that URL from the chat endpoint id:
# RUNPOD_CHAT_ENDPOINT_ID=
# Optional model name:
# LLM_CHAT_MODEL=qwen2.5-72b-instruct
